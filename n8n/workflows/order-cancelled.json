{
  "name": "Workflow 2 — Pedido Cancelado",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "order-cancelled",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-cancelled",
      "name": "Webhook — Pedido Cancelado",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "order-cancelled"
    },
    {
      "parameters": {
