          "options": { "caseSensitive": true },
          "conditions": [
            {
              "leftValue": "={{ $json.new_status }}",
              "rightValue": "cancelled",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "filter-cancelled",
      "name": "Filtro — new_status = cancelled",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://app/api/affiliates/{{ $json.affiliate_id }}/summary",
        "options": {}
      },
      "id": "get-affiliate-summary",
      "name": "Consulta Summary do Afiliado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "leftValue": "={{ $json.data.cancellation_rate }}",
              "rightValue": 30,
              "operator": { "type": "number", "operation": "gt" }
            }
          ]
        }
      },
      "id": "check-rate",
      "name": "Taxa de Cancelamento > 30%?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://webhook.site/your-unique-url-alert",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "alert",        "value": "⚠️ Afiliado #{{ $('Webhook — Pedido Cancelado').item.json.affiliate_id }} com alta taxa de cancelamento — atenção!" },
            { "name": "affiliate_id", "value": "={{ $('Webhook — Pedido Cancelado').item.json.affiliate_id }}" },
            { "name": "cancellation_rate", "value": "={{ $json.data.cancellation_rate }}" }
          ]
        },
        "options": {}
      },
      "id": "alert-high-rate",
      "name": "Alerta — Afiliado em Atenção",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://webhook.site/your-unique-url-sheets",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "order_id",     "value": "={{ $('Webhook — Pedido Cancelado').item.json.order_id }}" },
            { "name": "affiliate_id", "value": "={{ $('Webhook — Pedido Cancelado').item.json.affiliate_id }}" },
            { "name": "total_value",  "value": "={{ $('Webhook — Pedido Cancelado').item.json.total_value }}" },
            { "name": "cancelled_at", "value": "={{ $('Webhook — Pedido Cancelado').item.json.occurred_at }}" },
            { "name": "status",       "value": "cancelled" }
          ]
        },
        "options": {}
      },
      "id": "sheets-cancelled",
      "name": "Registra no Sheets (webhook.site mock)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 420]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"ok\" }",
        "options": {}
      },
      "id": "respond-cancelled",
      "name": "Responde OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1440, 300]
    }
